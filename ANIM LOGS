local loggerActive = false
local currentTrack = nil
local lastLoggedId = ""
local lastLoggedName = "Custom Emote"
local isFrozen = false

local function playAnimById(id)
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        if currentTrack then currentTrack:Stop() end

        local newAnim = Instance.new("Animation")
        newAnim.AnimationId = "rbxassetid://" .. id

        currentTrack = char.Humanoid:LoadAnimation(newAnim)
        currentTrack:Play()
        isFrozen = false
        FreezeBtn.Text = "Freeze Frame"
        TimerLabel.Text = "Freeze Status: Unfrozen"
        showToast("Playing ID: " .. id)
    end
end

