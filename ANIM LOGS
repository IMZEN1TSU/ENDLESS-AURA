local function showToast(msg)
    ToastText.Text = msg
    Toast.Position = UDim2.new(0.5, -130, 0.92, 0)
    Toast.BackgroundTransparency = 1
    ToastText.TextTransparency = 1
    Toast.Visible = true

    TweenService:Create(Toast, TweenInfo.new(0.3), {Position = UDim2.new(0.5, -130, 0.86, 0), BackgroundTransparency = 0}):Play()
    TweenService:Create(ToastText, TweenInfo.new(0.3), {TextTransparency = 0}):Play()

    task.delay(2, function()
        local hideTween = TweenService:Create(Toast, TweenInfo.new(0.3), {Position = UDim2.new(0.5, -130, 0.92, 0), BackgroundTransparency = 1})
        TweenService:Create(ToastText, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
        hideTween:Play()
        hideTween.Completed:Connect(function()
            Toast.Visible = false
        end)
    end)
end

