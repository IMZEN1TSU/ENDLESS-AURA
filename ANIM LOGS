-- MODIFIED SAVE Action Logic (2 TextBoxes + Save Button)
SaveBtn.MouseButton1Click:Connect(function()
    local nameValue = SaveNameBox.Text:gsub("^%s*(.-)%s*$", "%1")
    local idValue = SaveIDBox.Text:gsub("^%s*(.-)%s*$", "%1")
    
    -- Extract numeric ID from input
    local targetId = idValue:match("%d+") or idValue
    local targetName = nameValue ~= "" and nameValue or "Emote " .. targetId

    if not targetId or targetId == "" then
        showToast("Please enter an Anim ID!")
        return
    end

    -- Check Duplicates
    for _, emote in ipairs(savedEmotes) do
        if emote.Id == targetId then
            showToast("ID already saved!")
            return
        end
    end

    table.insert(savedEmotes, {Name = targetName, Id = targetId})
    saveData()
    renderSavedList()
    
    -- Clear the text boxes after saving
    SaveNameBox.Text = ""
    SaveIDBox.Text = ""
    
    showToast("Saved: " .. targetName .. " (ID: " .. targetId .. ")")
end)

