-- Animation Detector Event
local function setupDetector(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    if not humanoid then return end

    humanoid.AnimationPlayed:Connect(function(track)
        if not loggerActive then return end

        local animObj = track.Animation
        if animObj then
            local animId = animObj.AnimationId:match("%d+") or animObj.AnimationId
            local animName = (animObj.Name ~= "" and animObj.Name) or "Emote"

            if animId and animId ~= lastLoggedId then
                lastLoggedId = animId
                lastLoggedName = animName
                InfoLabel.Text = "Name: " .. animName .. " | ID: " .. animId

                if setclipboard then
                    setclipboard(animId)
                    showToast("Copied ID: " .. animId)
                end
            end
        end
    end)
end

if LocalPlayer.Character then setupDetector(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(setupDetector)

