end)

-- Freeze Button Click
FreezeBtn.MouseButton1Click:Connect(function()
    if not currentTrack or not currentTrack.IsPlaying then
        showToast("Play an animation first!")
        return
    end

    if not isFrozen then
        local frozenTime = math.floor(currentTrack.TimePosition * 100) / 100
        currentTrack:AdjustSpeed(0)
        isFrozen = true
        FreezeBtn.Text = "Resume Frame"
        TimerLabel.Text = "Frozen at: " .. tostring(frozenTime) .. "s / " .. math.floor(currentTrack.Length * 100) / 100 .. "s"
        showToast("Frozen at " .. tostring(frozenTime) .. "s")
    else
        currentTrack:AdjustSpeed(1)
        isFrozen = false
        FreezeBtn.Text = "Freeze Frame"
        TimerLabel.Text = "Freeze Status: Unfrozen"
        showToast("Resumed Animation")
    end
end)

-- Stop Button Click
StopBtn.MouseButton1Click:Connect(function()
    if currentTrack then
        currentTrack:Stop()
        currentTrack = nil
        isFrozen = false
        FreezeBtn.Text = "Freeze Frame"
        TimerLabel.Text = "Freeze Status: Unfrozen"
        showToast("Stopped Animation")
    end
end)

