local SAVE_FILE_NAME = "SavedEmotesData.json"

-- Data Saving & Loading Functions (Delta Executor Compatible)
local function loadSavedData()
    if readfile and isfile and isfile(SAVE_FILE_NAME) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(SAVE_FILE_NAME))
        end)
        if success and type(result) == "table" then
            return result
        end
    end
    return {}
end

local savedEmotes = loadSavedData()

local function saveData()
    if writefile then
        pcall(function()
            writefile(SAVE_FILE_NAME, HttpService:JSONEncode(savedEmotes))
        end)
    end
end

