-- ========================================================
-- SCRIPT USER TAGS ONLY (Sirf Script Users ke Tags)
-- ========================================================

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ========================================================
-- SCRIPT USERS LIST (Jo script use kar rahe hain)
-- ========================================================
local scriptUsers = {}  -- Isme sirf script users store honge

-- ========================================================
-- APNA ID REGISTER KAREIN
-- ========================================================
local function registerSelf()
    -- Signal bhejein ke ye player script use kar raha hai
    -- Hum local storage use karenge
    local userId = player.UserId
    
    -- Register in local table
    scriptUsers[userId] = {
        Name = player.Name,
        DisplayName = player.DisplayName,
        UserId = userId,
        IsScriptUser = true
    }
    
    -- Fire remote (agar server support kare toh)
    -- Otherwise local hi use karenge
    local remote = ReplicatedStorage:FindFirstChild("ScriptUserSignal")
    if remote then
        remote:FireServer("register", userId)
    end
    
    print("✅ Registered as Script User: " .. player.Name)
end

-- ========================================================
-- CHECK IF PLAYER IS SCRIPT USER
-- ========================================================
local function isScriptUser(targetPlayer)
    if not targetPlayer then return false end
    
    -- Check local list
    if scriptUsers[targetPlayer.UserId] then
        return true
    end
    
    -- Check player ke character mein kuch flag hai?
    local character = targetPlayer.Character
    if character then
        -- Agar player ke paas ye script hai toh uske character mein kuch hoga
        -- Jaise ek specific Part ya Attribute
        if character:FindFirstChild("ScriptUserTag") then
            return true
        end
    end
    
    -- Check player ke PlayerGui mein script hai?
    local playerGui = targetPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui and playerGui:FindFirstChild("AuraHUD") then
        return true
    end
    
    return false
end

-- ========================================================
-- TAG CREATE FUNCTION (Sirf Script Users ke liye)
-- ========================================================
local function createTagForScriptUser(targetPlayer)
    if not targetPlayer then return end
    if targetPlayer == player then return end  -- Apna tag nahi dikhana
    
    -- CHECK: Sirf script users ko tag milega
    if not isScriptUser(targetPlayer) then
        -- Agar tag already hai toh remove karein (non-script user)
        local character = targetPlayer.Character
        if character then
            local head = character:FindFirstChild("Head")
            if head then
                local tag = head:FindFirstChild("OverheadTag")
                if tag then 
                    tag:Destroy() 
                end
            end
        end
        return
    end
    
    -- Ab script user hai, tag create karein
    local character = targetPlayer.Character
    if not character then return end
    
    local head = character:FindFirstChild("Head")
    if not head then return end
    
    -- Agar tag already hai toh enabled kar do
    local existingTag = head:FindFirstChild("OverheadTag")
    if existingTag then
        existingTag.Enabled = true
        return
    end
    
    -- ===== TAG CREATE KAREIN =====
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "OverheadTag"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 300
    billboard.Enabled = true
    billboard.Parent = head
    
    -- Main Frame
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.BackgroundTransparency = 0.4
    frame.BorderSizePixel = 0
    frame.Parent = billboard
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(200, 0, 0)
    stroke.Thickness = 2
    stroke.Parent = frame
    
    -- Player Name
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
    nameLabel.Position = UDim2.new(0, 0, 0.05, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = targetPlayer.DisplayName or targetPlayer.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextXAlignment = Enum.TextXAlignment.Center
    nameLabel.Parent = frame
    
    -- "SCRIPT USER" Badge
    local badgeLabel = Instance.new("TextLabel")
    badgeLabel.Size = UDim2.new(1, 0, 0.35, 0)
    badgeLabel.Position = UDim2.new(0, 0, 0.52, 0)
    badgeLabel.BackgroundTransparency = 1
    badgeLabel.Text = "⚡ SCRIPT USER ⚡"
    badgeLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    badgeLabel.TextScaled = true
    badgeLabel.Font = Enum.Font.GothamBold
    badgeLabel.TextXAlignment = Enum.TextXAlignment.Center
    badgeLabel.Parent = frame
    
    -- Glow effect
    local glowLabel = Instance.new("TextLabel")
    glowLabel.Size = UDim2.new(1, 0, 0.35, 0)
    glowLabel.Position = UDim2.new(0, 0, 0.52, 0)
    glowLabel.BackgroundTransparency = 1
    glowLabel.Text = "⚡ SCRIPT USER ⚡"
    glowLabel.TextColor3 = Color3.fromRGB(0, 255, 50)
    glowLabel.TextScaled = true
    glowLabel.Font = Enum.Font.GothamBold
    glowLabel.TextXAlignment = Enum.TextXAlignment.Center
    glowLabel.TextTransparency = 0.6
    glowLabel.Parent = frame
    
    print("✅ Tag created for: " .. targetPlayer.Name)
    return billboard
end

-- ========================================================
-- DETECT SCRIPT USERS (Auto-detect kaun script use kar raha)
-- ========================================================
local function detectScriptUsers()
    for _, otherPlayer in pairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            -- Check agar player script user hai
            if isScriptUser(otherPlayer) then
                scriptUsers[otherPlayer.UserId] = {
                    Name = otherPlayer.Name,
                    DisplayName = otherPlayer.DisplayName,
                    UserId = otherPlayer.UserId,
                    IsScriptUser = true
                }
                -- Tag create karein
                createTagForScriptUser(otherPlayer)
            else
                -- Non-script user ka tag remove karein agar hai
                local character = otherPlayer.Character
                if character then
                    local head = character:FindFirstChild("Head")
                    if head then
                        local tag = head:FindFirstChild("OverheadTag")
                        if tag then 
                            tag:Destroy() 
                        end
                    end
                end
            end
        end
    end
end

-- ========================================================
-- WATCHDOG - Continuously check for script users
-- ========================================================
task.spawn(function()
    while true do
        wait(3)  -- Har 3 second mein check
        
        for _, otherPlayer in pairs(Players:GetPlayers()) do
            if otherPlayer ~= player then
                if isScriptUser(otherPlayer) then
                    -- Script user hai, tag ensure karein
                    createTagForScriptUser(otherPlayer)
                else
                    -- Script user nahi hai, tag remove karein
                    local character = otherPlayer.Character
                    if character then
                        local head = character:FindFirstChild("Head")
                        if head then
                            local tag = head:FindFirstChild("OverheadTag")
                            if tag then 
                                tag:Destroy() 
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- ========================================================
-- EVENT HANDLERS
-- ========================================================

-- Naya player join kare
Players.PlayerAdded:Connect(function(newPlayer)
    if newPlayer ~= player then
        task.wait(1)
        
        -- Check karein agar script user hai toh
        newPlayer.CharacterAdded:Connect(function(char)
            task.wait(1)
            if isScriptUser(newPlayer) then
                scriptUsers[newPlayer.UserId] = {
                    Name = newPlayer.Name,
                    DisplayName = newPlayer.DisplayName,
                    UserId = newPlayer.UserId,
                    IsScriptUser = true
                }
                createTagForScriptUser(newPlayer)
            end
        end)
        
        -- Agar character already hai toh
        if newPlayer.Character then
            task.wait(0.5)
            if isScriptUser(newPlayer) then
                scriptUsers[newPlayer.UserId] = {
                    Name = newPlayer.Name,
                    DisplayName = newPlayer.DisplayName,
                    UserId = newPlayer.UserId,
                    IsScriptUser = true
                }
                createTagForScriptUser(newPlayer)
            end
        end
    end
end)

-- Player leave kare toh cleanup
Players.PlayerRemoving:Connect(function(leavingPlayer)
    scriptUsers[leavingPlayer.UserId] = nil
    if leavingPlayer.Character then
        local head = leavingPlayer.Character:FindFirstChild("Head")
        if head then
            local tag = head:FindFirstChild("OverheadTag")
            if tag then tag:Destroy() end
        end
    end
end)

-- ========================================================
-- INITIAL SETUP
-- ========================================================
task.spawn(function()
    wait(1.5)  -- Game load hone ke liye wait
    
    -- Apne aap ko register karein
    registerSelf()
    
    -- Sabhi existing players check karein
    detectScriptUsers()
    
    print("✅ Script User Tag System Started!")
    print("👥 Script Users Found: " .. #scriptUsers)
    
    -- Force update after 3 seconds
    wait(3)
    detectScriptUsers()
end)

