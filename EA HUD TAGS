-- ========================================================
-- ANIMATION APPLY / REMOVE (FIXED IDLE GLITCH)
-- ========================================================
local function waitForAnimate(char)
    for _ = 1, 40 do
        local a = char:FindFirstChild("Animate")
        if a and a:FindFirstChild("idle") and a:FindFirstChild("run") and a:FindFirstChild("walk") then
            return a
        end
        task.wait(0.1)
    end
    return nil
end

local function setAnim(animObj, id)
    if animObj and id then
        animObj.AnimationId = "rbxassetid://" .. tostring(id)
    end
end

local function backupAnim(animObj, key)
    if animObj and not defaultAnims[key] then
        defaultAnims[key] = animObj.AnimationId
    end
end

local function applyAdidasAnimations()
    local char = player.Character
    if not char or not char.Parent then return false end
    
    local animate = waitForAnimate(char)
    if not animate then return false end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                track:Stop(0.1)
            end
        end
    end

    local runObj   = animate:FindFirstChild("run") and animate.run:FindFirstChildOfClass("Animation")
    local walkObj  = animate:FindFirstChild("walk") and animate.walk:FindFirstChildOfClass("Animation")
    local jumpObj  = animate:FindFirstChild("jump") and animate.jump:FindFirstChildOfClass("Animation")
    local fallObj  = animate:FindFirstChild("fall") and animate.fall:FindFirstChildOfClass("Animation")
    local climbObj = animate:FindFirstChild("climb") and animate.climb:FindFirstChildOfClass("Animation")
    local swimObj  = animate:FindFirstChild("swim") and animate.swim:FindFirstChildOfClass("Animation")
    local swimIdle = animate:FindFirstChild("swimidle") and animate.swimidle:FindFirstChildOfClass("Animation")
    local idleFolder = animate:FindFirstChild("idle")

    backupAnim(walkObj, "walk")
    backupAnim(runObj, "run")
    backupAnim(jumpObj, "jump")
    backupAnim(fallObj, "fall")
    backupAnim(climbObj, "climb")
    backupAnim(swimObj, "swim")
    backupAnim(swimIdle, "swimidle")

    setAnim(walkObj, ADIDAS_PACK.WalkAnim)
    setAnim(runObj, ADIDAS_PACK.RunAnim)
    setAnim(jumpObj, ADIDAS_PACK.JumpAnim)
    setAnim(fallObj, ADIDAS_PACK.FallAnim)
    setAnim(climbObj, ADIDAS_PACK.ClimbAnim)
    setAnim(swimObj, ADIDAS_PACK.Swim)
    setAnim(swimIdle, ADIDAS_PACK.SwimIdle)

    if idleFolder then
        local a1 = idleFolder:FindFirstChild("Animation1")
        local a2 = idleFolder:FindFirstChild("Animation2")
        backupAnim(a1, "idle1")
        backupAnim(a2, "idle2")
        setAnim(a1, ADIDAS_PACK.Animation1)
        setAnim(a2, ADIDAS_PACK.Animation2)
    end

    animate.Disabled = true
    task.wait(0.05)
    animate.Disabled = false

    isAnimOn = true
    AuraState.animEnabled = true
    return true
end

local function removeAdidasAnimations()
    local char = player.Character
    if not char or not char.Parent then return end
    
    local animate = waitForAnimate(char)
    if not animate then return end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                track:Stop(0.1)
            end
        end
    end

    local runObj   = animate:FindFirstChild("run") and animate.run:FindFirstChildOfClass("Animation")
    local walkObj  = animate:FindFirstChild("walk") and animate.walk:FindFirstChildOfClass("Animation")
    local jumpObj  = animate:FindFirstChild("jump") and animate.jump:FindFirstChildOfClass("Animation")
    local fallObj  = animate:FindFirstChild("fall") and animate.fall:FindFirstChildOfClass("Animation")
    local climbObj = animate:FindFirstChild("climb") and animate.climb:FindFirstChildOfClass("Animation")
    local swimObj  = animate:FindFirstChild("swim") and animate.swim:FindFirstChildOfClass("Animation")
    local swimIdle = animate:FindFirstChild("swimidle") and animate.swimidle:FindFirstChildOfClass("Animation")
    local idleFolder = animate:FindFirstChild("idle")

    if walkObj and defaultAnims["walk"] then walkObj.AnimationId = defaultAnims["walk"] end
    if runObj and defaultAnims["run"] then runObj.AnimationId = defaultAnims["run"] end
    if jumpObj and defaultAnims["jump"] then jumpObj.AnimationId = defaultAnims["jump"] end
    if fallObj and defaultAnims["fall"] then fallObj.AnimationId = defaultAnims["fall"] end
    if climbObj and defaultAnims["climb"] then climbObj.AnimationId = defaultAnims["climb"] end
    if swimObj and defaultAnims["swim"] then swimObj.AnimationId = defaultAnims["swim"] end
    if swimIdle and defaultAnims["swimidle"] then swimIdle.AnimationId = defaultAnims["swimidle"] end

    if idleFolder then
        local a1 = idleFolder:FindFirstChild("Animation1")
        local a2 = idleFolder:FindFirstChild("Animation2")
        if a1 and defaultAnims["idle1"] then a1.AnimationId = defaultAnims["idle1"] end
        if a2 and defaultAnims["idle2"] then a2.AnimationId = defaultAnims["idle2"] end
    end

    animate.Disabled = true
    task.wait(0.05)
    animate.Disabled = false

    isAnimOn = false
    AuraState.animEnabled = false
end

local function toggleAnim()
    if isAnimOn then
        removeAdidasAnimations()
    else
        applyAdidasAnimations()
    end
end

