    local slideTween = TweenService:Create(sliderFrame, TweenInfo.new(0.45, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {Position = targetSliderPos})
    
    rotationTween:Play()
    slideTween:Play()
    slideTween.Completed:Connect(function() isTweeningHUD = false end)
end)

