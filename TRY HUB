-- TARGET PLAYER FINDER LOGIC
---------------------------------------------------------
local function getTargetPlayer()
    local targetName = textBox.Text
    if targetName == "" then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and (p.Name:lower():find(targetName:lower()) or p.DisplayName:lower():find(targetName:lower())) then
            return p
        end
    end
    return nil
end

local function notify(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title or "KANEKI HUB",
            Text = text or "",
            Duration = 2
        })
    end)
end

---------------------------------------------------------
-- TARGET ESP LOGIC
---------------------------------------------------------
local targetESPActive = false

local function toggleTargetESP(state)
    targetESPActive = state
    task.spawn(function()
        local currentHighlight = nil
        
        local function cleanup()
            if currentHighlight then 
                currentHighlight:Destroy() 
                currentHighlight = nil 
            end
        end
        
        while targetESPActive do
            local t = getTargetPlayer()
            if t and t.Character then
                if not currentHighlight or currentHighlight.Parent ~= t.Character then
                    cleanup()
                    
                    currentHighlight = Instance.new("Highlight")
                    currentHighlight.Name = "PurpleGlowESP"
                    currentHighlight.FillColor = Color3.fromRGB(180, 50, 255) 
                    currentHighlight.FillTransparency = 0.5 
                    currentHighlight.OutlineColor = Color3.fromRGB(70, 0, 130) 
                    currentHighlight.OutlineTransparency = 0
                    currentHighlight.Parent = t.Character
                end
            else
                cleanup()
            end
            task.wait(0.01)
        end
        cleanup()
    end)
end

