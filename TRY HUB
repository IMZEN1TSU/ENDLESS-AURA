local isSpammerOpen = false

local function updateButtonAppearance()
    if not isOpen then
        csSpammerToggleBtn.BackgroundColor3 = Color3.fromRGB(35, 0, 45)
        csSpammerToggleBtn.Text = ">"
    else
        if isSpammerOpen then
            csSpammerToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 100)
            csSpammerToggleBtn.Text = "<"
        else
            csSpammerToggleBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 80)
            csSpammerToggleBtn.Text = ">"
        end
    end
end

local function toggleSpammerUI(state)
    if not isOpen then return end
    if state == nil then isSpammerOpen = not isSpammerOpen else isSpammerOpen = state end
    
    if isSpammerOpen then
        spammerFrame.Visible = true
        spammerFrame.Size = UDim2.new(0, 0, 1, 0)
        spammerFrame:TweenSize(UDim2.new(0, 210, 1, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Sine, 0.2, true)
    else
        spammerFrame:TweenSize(UDim2.new(0, 0, 1, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Sine, 0.2, true, function()
            if not isSpammerOpen then spammerFrame.Visible = false end
        end)
    end
    updateButtonAppearance()
end

