local function processChatCommand(msgText)
    local text = string.lower(msgText)
    local target = getTargetPlayer()

    -- Bring
    if text == "bring" then
        if target then
            currentMode = "Bring"
            activeTarget = target
            applyAttachmentLogic()
        end
    elseif text == "bring off" or text == "unbring" then
        if currentMode == "Bring" then stopAttachment() end

    -- Bring V2
    elseif text == "bringv2" or text == "bring v2" then
        if target then
            currentMode = "BringV2"
            activeTarget = target
            applyAttachmentLogic()
        end
    elseif text == "bringv2 off" or text == "unbringv2" or text == "bring v2 off" then
        if currentMode == "BringV2" then stopAttachment() end

    -- Bang
    elseif text == "bang" then
        if target then
            currentMode = "Bang"
            activeTarget = target
            applyAttachmentLogic()
        end
    elseif text == "bang off" or text == "unbang" then
        if currentMode == "Bang" then stopAttachment() end

    -- FaceBang
    elseif text == "facebang" or text == "face bang" then
        if target then
            currentMode = "FaceBang"
            activeTarget = target
            applyAttachmentLogic()
        end
    elseif text == "facebang off" or text == "unfacebang" or text == "face bang off" then
        if currentMode == "FaceBang" then stopAttachment() end

    -- Boobs
    elseif text == "boobs" then
        if target then
            currentMode = "BOOBS"
            activeTarget = target
            applyAttachmentLogic()
        end
    elseif text == "boobs off" or text == "unboobs" then
        if currentMode == "BOOBS" then stopAttachment() end

    -- AS
    elseif text == "as" then
        if target then
            currentMode = "AS"
            activeTarget = target
            sideButton.Text = "UnAS"
            sideButton.TextColor3 = Color3.fromRGB(255, 120, 180)
            sideButton.BackgroundColor3 = Color3.fromRGB(120, 0, 80)
            applyAttachmentLogic()
        end
    elseif text == "as off" or text == "unas" then
        if currentMode == "AS" then stopAttachment() end

    -- Suck
    elseif text == "suck" then
        if target then
            currentMode = "Suck"
            activeTarget = target
            applyAttachmentLogic()
        end
    elseif text == "suck off" or text == "unsuck" then
        if currentMode == "Suck" then stopAttachment() end

    -- Fingering
    elseif text == "fingering" then
        if target then
            currentMode = "Fingering"
            activeTarget = target
            fingeringButton.Text = "UnFingering"
            fingeringButton.TextColor3 = Color3.fromRGB(255, 120, 180)
            fingeringButton.BackgroundColor3 = Color3.fromRGB(120, 0, 80)
            applyAttachmentLogic()
        end
    elseif text == "fingering off" or text == "unfingering" then
        if currentMode == "Fingering" then stopAttachment() end

    -- Slap
    elseif text == "slap" then
        if target then
            currentMode = "Slap"
            activeTarget = target
            slapButton.Text = "UnSlap"
            slapButton.TextColor3 = Color3.fromRGB(255, 120, 180)
            slapButton.BackgroundColor3 = Color3.fromRGB(120, 0, 80)
            applyAttachmentLogic()
        end
    elseif text == "slap off" or text == "unslap" then
        if currentMode == "Slap" then stopAttachment() end

    -- Spam
    elseif text == "spam" or text == "spam on" then
        if not isSpamming then toggleSpam(true) end
    elseif text == "spam off" or text == "unspam" then
        if isSpamming then toggleSpam(false) end

    -- Target ESP
    elseif text == "esp on" or text == "esp" then
        if target and not targetESPActive then
            toggleTargetESP(true)
            targetEspButton.Text = "Target ESP: ON"
            targetEspButton.TextColor3 = Color3.fromRGB(255, 120, 180)
            targetEspButton.BackgroundColor3 = Color3.fromRGB(120, 0, 80)
        end
    elseif text == "esp off" or text == "unesp" then
        if targetESPActive then
            toggleTargetESP(false)
            targetEspButton.Text = "Target ESP: OFF"
            targetEspButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            targetEspButton.BackgroundColor3 = Color3.fromRGB(45, 0, 50)
        end

    -- Copy Chat
    elseif text == "copychat on" or text == "copychat" then
        if target and not chatSyncActive then
            chatTargetPlayer = target
            chatSyncActive = true
            copyChatButton.Text = "Copy Chat: ON"
            copyChatButton.TextColor3 = Color3.fromRGB(255, 120, 180)
            copyChatButton.BackgroundColor3 = Color3.fromRGB(120, 0, 80)
        end
    elseif text == "copychat off" or text == "uncopychat" then
        if chatSyncActive then
            chatSyncActive = false
            chatTargetPlayer = nil
            copyChatButton.Text = "Copy Chat: OFF"
            copyChatButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            copyChatButton.BackgroundColor3 = Color3.fromRGB(45, 0, 50)
        end

    -- Copy Anim
    elseif text == "copyanim on" or text == "copyanim" then
        if target and not copyNinjaActive then
            copyTargetPlayer = target
            copyNinjaActive = true
            copyAnimations()
            startCopyLoop()
            copyAnimButton.Text = "Copy Anim: ON"
            copyAnimButton.TextColor3 = Color3.fromRGB(255, 120, 180)
            copyAnimButton.BackgroundColor3 = Color3.fromRGB(120, 0, 80)
        end
    elseif text == "copyanim off" or text == "uncopyanim" then
        if copyNinjaActive then
            stopCopyLoop()
            copyAnimButton.Text = "Copy Anim: OFF"
            copyAnimButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            copyAnimButton.BackgroundColor3 = Color3.fromRGB(45, 0, 50)
        end

    -- View Target
    elseif text == "view" then
        if not isViewing then toggleView() end
    elseif text == "unview" or text == "view off" then
        if isViewing then toggleView() end

    -- Purple TP
    elseif text == "tp" or text == "purpletp" then
        executePurpleTP()
    end
end

