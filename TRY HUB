local function playEmote(animId, speed, priority)
    local char = player.Character or player.CharacterAdded:Wait()
    local humanoid = char:WaitForChild("Humanoid")
    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)

    if currentTrack then
        currentTrack:Stop()
        currentTrack:Destroy()
    end

    local animation = Instance.new("Animation")
    animation.AnimationId = "rbxassetid://" .. tostring(animId)

    currentTrack = animator:LoadAnimation(animation)
    currentTrack.Priority = priority or Enum.AnimationPriority.Action
    currentTrack:Play()
    currentTrack:AdjustSpeed(speed or 1)
    return currentTrack
end

local function applyAttachmentLogic()
    if not currentMode or not activeTarget then return end

    if freezeThread then
        task.cancel(freezeThread)
        freezeThread = nil
    end

    if slapSoundThread then
        task.cancel(slapSoundThread)
        slapSoundThread = nil
    end

    if not savedReturnCFrame and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        savedReturnCFrame = player.Character.HumanoidRootPart.CFrame
    end

    local animId = "128790445741213"
    local speed = 1

    if currentMode == "AS" then
        animId = "77464682913511"
    elseif currentMode == "FaceBang" then
        animId = "79952107676081"
    elseif currentMode == "BOOBS" then
        animId = "10713966026"
    elseif currentMode == "Suck" then
        animId = "13694096724"
    elseif currentMode == "Fingering" then
        animId = "124127012123232"
    elseif currentMode == "Slap" then
        animId = "123599023212125"
    elseif currentMode == "Bring" or currentMode == "BringV2" then
        animId = "95048572625505"
        speed = 88
    end

    local track = nil
    if currentMode == "Suck" then
        if player.Character and player.Character:FindFirstChild("Animate") then
            player.Character.Animate.Disabled = true
        end
        track = playEmote(animId, 0, Enum.AnimationPriority.Action4)
        track.TimePosition = 3.4
        suckStartTime = os.clock()
    else
        track = playEmote(animId, speed)
    end

    if currentMode == "BOOBS" then
        freezeThread = task.spawn(function()
            while currentMode == "BOOBS" and track do
                track.TimePosition = 2.60
                track:AdjustSpeed(0)
                RunService.RenderStepped:Wait()
                track.TimePosition = 2.59
                track:AdjustSpeed(0)
                RunService.RenderStepped:Wait()
            end
        end)
    end

    if currentMode == "Slap" then
        slapSoundThread = task.spawn(function()
            local playedThisLoop = false
            while currentMode == "Slap" and track do
                local currentTime = track.TimePosition
                if currentTime >= 1.10 and not playedThisLoop then
                    playSlapSound()
                    playedThisLoop = true
                elseif currentTime < 1.10 then
                    playedThisLoop = false
                end
                RunService.RenderStepped:Wait()
            end
        end)
    end

    local function updateCFrame()
        local myChar = player.Character
        local targetChar = activeTarget.Character

        if myChar and targetChar and myChar:FindFirstChild("HumanoidRootPart") then
            local myHRP = myChar.HumanoidRootPart
            local myHumanoid = myChar:FindFirstChildOfClass("Humanoid")
            local tOrient = getOrientationPart(targetChar)

            if not tOrient or not tOrient:IsDescendantOf(workspace) or (myHumanoid and myHumanoid.Health <= 0) then
                stopAttachment()
                return
            end

            pcall(function()
                sethiddenproperty(myHRP, "PhysicsRepRootPart", tOrient)
            end)

            local offset = CFrame.new()

            if currentMode == "AS" then
                offset = tOrient.CFrame * CFrame.new(0.0, -2.3, 7.0) * CFrame.Angles(math.rad(88), 0, 0)
            elseif currentMode == "Bang" then
                offset = tOrient.CFrame * CFrame.new(0, 0.4, 2)
            elseif currentMode == "FaceBang" then
                local targetHead = targetChar:FindFirstChild("Head")
                local baseCFrame = targetHead and targetHead.CFrame or tOrient.CFrame
                offset = baseCFrame * CFrame.new(0, 1.4, -2.0) * CFrame.Angles(0, math.rad(180), 0)
            elseif currentMode == "BOOBS" then
                local targetChest = targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso") or tOrient
                offset = targetChest.CFrame * CFrame.new(0.3, -2.1, -2.9) * CFrame.Angles(0, math.rad(176), 0)
            elseif currentMode == "Suck" then
                local timePassed = os.clock() - suckStartTime
                local oscillation = math.sin(timePassed * 12.5) * 0.4
                local currentDist = 4 + oscillation
                local targetCF = tOrient.CFrame
                local pos = targetCF.Position + (targetCF.LookVector * currentDist) + Vector3.new(0, 0.3, 0)
                offset = CFrame.lookAt(pos, targetCF.Position) * CFrame.Angles(math.rad(30), 0, 0)
                if myHumanoid then myHumanoid.PlatformStand = true end
                if track then track.TimePosition = 3.4 end
            elseif currentMode == "Fingering" then
                offset = tOrient.CFrame * CFrame.new(0.0, -0.4, -4.8) * CFrame.Angles(0, math.rad(182), 0)
            elseif currentMode == "Slap" then
                offset = tOrient.CFrame * CFrame.new(6.6, -1.3, 0.0) * CFrame.Angles(0, 0, math.rad(-4))
            elseif currentMode == "Bring" then
                local targetHRP = targetChar:FindFirstChild("HumanoidRootPart") or tOrient
                local currentDistance = (myHRP.Position - targetHRP.Position).Magnitude
                
                if currentDistance <= 1.0 then
                    glitchState = not glitchState
                    if glitchState then
                        offset = targetHRP.CFrame * CFrame.new(0, -500, 0)
                    else
                        offset = targetHRP.CFrame * CFrame.new(0, 0, 0)
                    end
                else
                    offset = targetHRP.CFrame * CFrame.new(0, 0, 0)
                end
            elseif currentMode == "BringV2" then
                local targetHRP = targetChar:FindFirstChild("HumanoidRootPart") or tOrient
                local currentDistance = (myHRP.Position - targetHRP.Position).Magnitude
                local flipRotation = CFrame.Angles(math.rad(87), 0, 0)
                
                if currentDistance <= 1.0 then
                    glitchState = not glitchState
                    if glitchState then
                        offset = (targetHRP.CFrame * flipRotation) * CFrame.new(0, -500, 0)
                    else
                        offset = targetHRP.CFrame * flipRotation
                    end
                else
                    offset = targetHRP.CFrame * flipRotation
                end
            end

            myHRP.CFrame = offset
            myHRP.Velocity = Vector3.new(0, 0, 0)
            myHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            myHRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            myHRP.RotVelocity = Vector3.new(0, 0, 0)
        end
    end

    if activeConnection then activeConnection:Disconnect() end
    if activeHeartbeat then activeHeartbeat:Disconnect() end
    if activePreSim then activePreSim:Disconnect() end

    activeConnection = RunService.RenderStepped:Connect(updateCFrame)
    activeHeartbeat = RunService.Heartbeat:Connect(updateCFrame)
    if currentMode == "Suck" then
        activePreSim = RunService.PreSimulation:Connect(updateCFrame)
    end
end

