-- // ===== AIMBOT LOGIC =====
local function GetClosestPlayer()
    local closest = nil
    local closestDist = aimFOV
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local root = player.Character.HumanoidRootPart
            local head = player.Character:FindFirstChild("Head")
            
            if head and root and player.Character.Humanoid.Health > 0 then
                local screenPos, onScreen = Camera:WorldToScreenPoint(head.Position)
                
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - UserInputService:GetMouseLocation()).Magnitude
                    
                    if dist < closestDist then
                        closestDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    
    return closest
end

-- // Aimbot loop
RunService.RenderStepped:Connect(function()
    if not aimbotEnabled then return end
    
    -- // Check if aim key is held
    local isHolding = false
    if aimbotKeybind == "RMB" then
        isHolding = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    else
        isHolding = UserInputService:IsKeyDown(Enum.KeyCode[aimbotKeybind])
    end
    
    if not isHolding then return end
    
    local target = GetClosestPlayer()
    if not target then return end
    
    local head = target.Character:FindFirstChild("Head")
    if not head then return end
    
    if silentAim then
        -- // Silent aim - spoof mouse position (simplified)
        local screenPos, onScreen = Camera:WorldToScreenPoint(head.Position)
        if onScreen then
            -- // For actual silent aim, would need to hook mouse events
            -- // This is a simplified version
        end
    else
        -- // Normal aim - move camera
        local targetPos = head.Position
        local cameraPos = Camera.CFrame.Position
        local lookVector = (targetPos - cameraPos).Unit
        
        -- // Smooth rotation
        local currentCFrame = Camera.CFrame
        local targetCFrame = CFrame.lookAt(cameraPos, targetPos)
        
        if smoothness > 1 then
            local lerpFactor = 1 / smoothness
            local newCFrame = currentCFrame:Lerp(targetCFrame, lerpFactor)
            Camera.CFrame = newCFrame
        else
            Camera.CFrame = targetCFrame
        end
    end
end)

-- // ===== ESP LOGIC =====
local function CreateESP(player)
    if player == LocalPlayer then return end
    if not player.Character then return end
    
    local head = player.Character:FindFirstChild("Head")
    if not head then return end
    
    -- // Billboard for name and distance
    local billboard = Instance.new("BillboardGui")
    billboard.Name = player.Name .. "_ESP"
    billboard.Parent = head
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.MaxDistance = 200
    billboard.AlwaysOnTop = true
    
    -- // Main frame
    local frame = Instance.new("Frame")
    frame.Parent = billboard
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(1, 0, 1, 0)
    
    -- // Name label
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Parent = frame
    nameLabel.BackgroundTransparency = 1
    nameLabel.Size = UDim2.new(1, 0, 0, 20)
    nameLabel.Position = UDim2.new(0, 0, 0, 0)
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextSize = 12
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextStrokeTransparency = 0.5
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.Visible = showNames
    
    -- // Distance label
    local distLabel = Instance.new("TextLabel")
    distLabel.Parent = frame
    distLabel.BackgroundTransparency = 1
    distLabel.Size = UDim2.new(1, 0, 0, 15)
    distLabel.Position = UDim2.new(0, 0, 0, 20)
    distLabel.Text = "0m"
    distLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    distLabel.TextSize = 10
    distLabel.Font = Enum.Font.Gotham
    distLabel.TextStrokeTransparency = 0.5
    distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    distLabel.Visible = showDistance
    
    -- // Health bar
    local healthBar = Instance.new("Frame")
    healthBar.Parent = head
    healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    healthBar.Size = UDim2.new(0, 30, 0, 4)
    healthBar.Position = UDim2.new(0.5, -15, 0, -1)
    healthBar.Visible = showHealth
    healthBar.ZIndex = 10
    
    local healthCorner = Instance.new("UICorner")
    healthCorner.CornerRadius = UDim.new(1, 0)
    healthCorner.Parent = healthBar
    
    local healthBg = Instance.new("Frame")
    healthBg.Parent = head
    healthBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    healthBg.Size = UDim2.new(0, 30, 0, 4)
    healthBg.Position = UDim2.new(0.5, -15, 0, -1)
    healthBg.ZIndex = 9
    healthBg.Visible = showHealth
    
    local healthBgCorner = Instance.new("UICorner")
    healthBgCorner.CornerRadius = UDim.new(1, 0)
    healthBgCorner.Parent = healthBg
    
    -- // Update health
    local function UpdateHealth()
        local humanoid = player.Character:FindFirstChild("Humanoid")
        if humanoid then
            local healthPercent = humanoid.Health / humanoid.MaxHealth
            healthBar.Size = UDim2.new(0, 30 * healthPercent, 0, 4)
            
            if healthPercent > 0.5 then
                healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
            elseif healthPercent > 0.25 then
                healthBar.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
            else
                healthBar.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            end
        end
    end
    
    UpdateHealth()
    
    -- // Update distance
    local function UpdateDistance()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (root.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                distLabel.Text = math.floor(dist) .. "m"
            end
        end
    end
    
    -- // Store objects for cleanup
    local espData = {
        Billboard = billboard,
        Frame = frame,
        NameLabel = nameLabel,
        DistLabel = distLabel,
        HealthBar = healthBar,
        HealthBg = healthBg,
        Player = player
    }
    
    table.insert(espObjects, billboard)
    table.insert(espObjects, healthBar)
    table.insert(espObjects, healthBg)
    
    -- // Update loop for health and distance
    game:GetService("RunService").Heartbeat:Connect(function()
        if not espEnabled then return end
        if not player.Character or not player.Character:FindFirstChild("Humanoid") then return end
        if player.Character.Humanoid.Health <= 0 then
            billboard.Enabled = false
            healthBar.Visible = false
            healthBg.Visible = false
            return
        end
        
        billboard.Enabled = true
        healthBar.Visible = showHealth
        healthBg.Visible = showHealth
        
        nameLabel.Visible = showNames
        distLabel.Visible = showDistance
        
        UpdateHealth()
        UpdateDistance()
    end)
